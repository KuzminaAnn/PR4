<Page x:Class="WpfAppPR4.Pages.RegistrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Регистрация" Grid.Row="0" FontSize="30" HorizontalAlignment="Center" Margin="10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Введите имя:" Margin="5" FontSize="25" VerticalAlignment="Center"/>
            <TextBox x:Name="Name" Margin="5, 20" FontSize="25" Height="30" Width="250" ToolTip="Введите имя"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Введите логин:" Margin="5" FontSize="25" VerticalAlignment="Center"/>
            <TextBox x:Name="Login" Margin="5, 20" FontSize="25" Height="30" Width="250" ToolTip="Введите логин"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Введите пароль:" Margin="5" FontSize="25" VerticalAlignment="Center"/>
            <PasswordBox x:Name="Password" Margin="5, 20" FontSize="25" Height="30" Width="250" ToolTip="Введите пароль"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Повторите пароль:" Margin="5" FontSize="25" VerticalAlignment="Center"/>
            <PasswordBox x:Name="Password2" Margin="5, 20" FontSize="25" Height="30" Width="250" ToolTip="Повторите пароль"/>
        </StackPanel>
        <Button x:Name="Regist" Content="Регистрация" Grid.Row="5" FontSize="25" Height="40" Width="160"/>
        <Button x:Name="Exet" Content="Назад" Grid.Row="6"  FontSize="20" Margin="15" Width="100" Height="30" Click="Exet_Click"/>
    </Grid>
</Page>
