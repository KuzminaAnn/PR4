<Page x:Class="WpfAppPR4.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список товаров" FontSize="25" Margin="10" HorizontalAlignment="Center"/>
        <DataGrid x:Name="ProductsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"  FontSize="15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
                <DataGridTextColumn Header="На складе" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Доступен" Binding="{Binding AvailabilityText}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить" Width="140" Height="35" Margin="5, 10" Click="AddButton_Click" FontSize="20"/>
            <Button Content="Редактировать" Width="140" Height="35" Margin="5, 10" Click="EditButton_Click" FontSize="20"/>
            <Button Content="Удалить" Width="140" Height="35" Margin="5, 10" Click="DeleteButton_Click" FontSize="20"/>
            <Button Content="Назад" Width="140" Height="35" Margin="5, 10" Click="BackButton_Click" FontSize="20"/>
            <Button Content="Выйти из аккаунта" Width="200" Height="35" Margin="5, 10" FontSize="20" Click="Button_Click_3"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Редактировать категории" Width="250" Height="35" Margin="5, 10" FontSize="20" Click="Button_Click"/>
            <Button Content="Заказы" Width="140" Height="35" Margin="5, 10" FontSize="20" Click="Button_Click_1"/>
            <Button Content="Отзывы" Width="140" Height="35" Margin="5, 10" FontSize="20" Click="Button_Click_2"/>
            <Button Content="ПВЗ" Width="140" Height="35" Margin="5, 10" FontSize="20" Click="Button_Click_5"/>
        </StackPanel>
    </Grid>
</Page>
