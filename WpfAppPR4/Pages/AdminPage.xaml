<Page x:Class="WpfAppPR4.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Список товаров" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <DataGrid x:Name="ProductsDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
                    <DataGridTextColumn Header="На складе" Binding="{Binding Quantity}" Width="80"/>
                    <!-- Используем вычисляемое свойство из DTO, чтобы не писать конвертеры -->
                    <DataGridTextColumn Header="Доступен" Binding="{Binding AvailabilityText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить" Width="120" Height="35" Margin="5" Click="AddButton_Click"/>
                <Button Content="Редактировать" Width="120" Height="35" Margin="5" Click="EditButton_Click"/>
                <Button Content="Удалить" Width="120" Height="35" Margin="5" Background="LightCoral" Click="DeleteButton_Click"/>
                <Button Content="Назад" Width="120" Height="35" Margin="5" Click="BackButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
