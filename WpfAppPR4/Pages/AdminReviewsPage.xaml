<Page x:Class="WpfAppPR4.Pages.AdminReviewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminReviewsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Все отзывы" Margin="5" FontSize="25" HorizontalAlignment="Center"/>

        <ListBox x:Name="ReviewsListBox" Grid.Row="1" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding ProductName, StringFormat='Товар: {0}'}" FontSize="20"/>
                        <TextBlock Text="{Binding UserName, StringFormat='Автор: {0}'}" FontSize="20"/>
                        <TextBlock Text="{Binding Rating, StringFormat='Рейтинг: {0}'}" FontSize="20"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="5" FontSize="20"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Удалить выбранный" Width="200" Height="35" Margin="5" Click="DeleteButton_Click" FontSize="20"/>
            <Button Content="Обновить" Width="120" Height="35" Margin="5" Click="RefreshButton_Click" FontSize="20"/>
            <Button Content="Назад" Width="120" Height="35" Margin="5" FontSize="20" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Page>
