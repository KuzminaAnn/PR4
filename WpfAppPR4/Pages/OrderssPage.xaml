<Page x:Class="WpfAppPR4.Pages.OrderssPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderssPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оформление заказа" FontSize="25" Margin="5"/>

        <ListBox x:Name="OrderItemsList" Grid.Row="1" Margin="5" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="15" Margin="5"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='x{0}'}" FontSize="15" Margin="5"/>
                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0} руб.}" FontSize="15" Margin="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="TotalText" Grid.Row="2" FontSize="20" HorizontalAlignment="Right" Margin="5"/>

        <StackPanel Grid.Row="3" Margin="5">
            <TextBlock Text="Способ получения:" FontSize="15" Margin="50"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <RadioButton x:Name="RbPickup" Content="Самовывоз из ПВЗ" FontSize="15" GroupName="Delivery" Checked="DeliveryType_Changed" Margin="5"/>
                <RadioButton x:Name="RbDelivery" Content="Доставка по адресу" FontSize="15" GroupName="Delivery" Checked="DeliveryType_Changed"/>
            </StackPanel>

            <StackPanel x:Name="PickupPanel" Visibility="Collapsed" Margin="5">
                <TextBlock Text="Выберите ПВЗ:" FontSize="15" Margin="5"/>
                <ComboBox x:Name="PickupCombo" FontSize="15" Height="35" Width="400" HorizontalAlignment="Left" DisplayMemberPath="Name"/>
            </StackPanel>

            <StackPanel x:Name="AddressPanel" Visibility="Collapsed" Margin="5">
                <TextBlock Text="Адрес доставки:" FontSize="15" Margin="5"/>
                <TextBox x:Name="AddressBox" FontSize="15" Height="35" Width="400" HorizontalAlignment="Left"/>
            </StackPanel>

            <Button Content="Оформить заказ" Margin="5" HorizontalAlignment="Right" Click="SubmitOrderss_Click"/>
        </StackPanel>
    </Grid>
</Page>
