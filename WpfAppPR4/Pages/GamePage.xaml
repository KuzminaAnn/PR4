<Page x:Class="WpfAppPR4.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название -->
        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Картинка и описание -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Image x:Name="GameImage" Width="200" Height="200" Margin="0,0,20,0" Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Описание:" FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="DescText" TextWrapping="Wrap" Width="300" Margin="0,5,0,0"/>

                <TextBlock Text="Цена:" FontWeight="Bold" FontSize="16" Margin="0,15,0,0"/>
                <TextBlock x:Name="PriceText" FontSize="18" Foreground="Green"/>

                <TextBlock Text="Рейтинг:" FontWeight="Bold" FontSize="16" Margin="0,15,0,0"/>
                <TextBlock x:Name="RatingText" FontSize="18"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="2" Content="Закрыть" HorizontalAlignment="Right" Padding="10,5" Click="Close_Click"/>
    </Grid>
</Page>
