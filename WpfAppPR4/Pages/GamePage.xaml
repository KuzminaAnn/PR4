<Page x:Class="WpfAppPR4.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="25" Margin="0,0,0,10"/>
        <Image Grid.Row="1" x:Name="GameImage" Width="200" Height="200" Margin="30" HorizontalAlignment="Right"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock Text="Описание:" FontSize="15"/>
            <TextBlock x:Name="DescText" FontSize="15" TextWrapping="Wrap" Width="300" HorizontalAlignment="Left" Margin="5"/>
            <TextBlock Text="Цена:" FontSize="15" Margin="5"/>
            <TextBlock x:Name="PriceText" FontSize="15" Foreground="Green"/>
            <TextBlock Text="Рейтинг:" FontSize="15" Margin="5"/>
            <TextBlock x:Name="RatingText" FontSize="15"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="Back" Content="На главную" HorizontalAlignment="Left" Margin="5" Click="Back_Click"/>
                <Button x:Name="Love" Content="В избранное" HorizontalAlignment="Left" Margin="5" Click="Love_Click"/>
                <Button x:Name="BuyNow" Content="Заказать" HorizontalAlignment="Left" Margin="5" Click="BuyNow_Click"/>
                <Button x:Name="basket" Content="В корзину" HorizontalAlignment="Left" Margin="5" Click="basket_Click"/>
            </StackPanel>
        </StackPanel>
        <!-- После блока с ценой/рейтингом -->
        <StackPanel Margin="5" Grid.Row="2">
            <TextBlock Text="Отзывы покупателей:" FontSize="20" Margin="5"/>

            <ItemsControl x:Name="ReviewsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <!-- Имя и рейтинг -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding UserName}" FontSize="16"/>
                                    <TextBlock Text=" ★ " FontSize="16"/>
                                    <TextBlock Text="{Binding Rating}" FontSize="16"/>
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Margin="5" FontSize="15"/>
                                </StackPanel>

                                <!-- Текст отзыва -->
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="5" FontSize="15"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>
