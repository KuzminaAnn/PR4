<Page x:Class="WpfAppPR4.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Играй и не теряй" FontSize="40" Grid.Row="0" HorizontalAlignment="Center"/>
        <Button Grid.Row="0" x:Name="Aff" Content="Авторизация" Width="100" Height="30" Click="Aff_Click" HorizontalAlignment="Right"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Сортировка:" VerticalAlignment="Center"/>
            <ComboBox x:Name="Sort" Height="30" Width="150" Margin="10" HorizontalAlignment="Left" SelectionChanged="Sort_SelectionChanged" FontSize="20"/>
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox x:Name="Poisc" FontSize="20" Foreground="#1F4E5F" Margin="10" Background="White" Height="30" Width="490" TextChanged="Poisc_TextChanged"/>
            <TextBlock Text="Фильтрация:" VerticalAlignment="Center"/>
            <ComboBox x:Name="Filtr" FontSize="20" DisplayMemberPath="Name" Height="30" Width="150" Margin="10" HorizontalAlignment="Right" SelectionChanged="Filtr_SelectionChanged"/>
        </StackPanel>
        <ListBox x:Name="Box" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="2" Background="#F4F7F7">
            <ListBox.ItemTemplate >
                <DataTemplate>
                    <StackPanel Margin="25, 15" Orientation="Vertical">
                        <Image Height="200" Width="200" Source="{Binding Image}"/>
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                            <TextBlock TextWrapping="NoWrap" Text="{Binding Name}" FontSize="20"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Price}" FontSize="20"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="20"/>
                        </StackPanel>
                        <Button x:Name="Podrob" Content="Подробнее" FontSize="15" Width="130" Height="40" Click="Podrob_Click" Margin="5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
