<Page x:Class="WpfAppPR4.Pages.AdminOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminOrdersPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Список заказов" FontSize="25" Margin="10" HorizontalAlignment="Center"/>

        <ListBox x:Name="OrdersListBox" Grid.Row="1" Grid.Column="0" Margin="10" SelectionChanged="OrdersListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding Id, StringFormat='Заказ №{0}'}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{Binding UserName, StringFormat='Клиент: {0}'}" FontSize="15"/>
                        <TextBlock Text="{Binding Date, StringFormat='Дата: {0}'}" FontSize="15"/>
                        <TextBlock Text="{Binding TotalPrice, StringFormat='Сумма: {0}'}" FontSize="15"/>
                        <TextBlock Text="{Binding StatusName, StringFormat='Статус: {0}'}" FontSize="15"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="1" BorderThickness="1" Padding="10">
            <ScrollViewer>
                <StackPanel x:Name="DetailsPanel">
                    <TextBlock Text="Выберите заказ для просмотра деталей" FontSize="20"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Button Content="Назад" Width="120" Height="35" Margin="5" FontSize="20" Click="Button_Click" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"/>
    </Grid>
</Page>
