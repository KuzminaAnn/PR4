<Page x:Class="WpfAppPR4.Pages.EditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditProductPage">

    <ScrollViewer Margin="20">
        <StackPanel Width="400">
            <TextBlock x:Name="TitleText" Text="Добавление товара" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Название:"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="DescriptionBox" Height="60" AcceptsReturn="True" Margin="0,0,0,10"/>

            <TextBlock Text="Категория:"/>
            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

            <TextBlock Text="Ссылка на изображение:"/>
            <TextBox x:Name="ImageBox" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Цена:"/>
                    <TextBox x:Name="PriceBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="Рейтинг:"/>
                    <TextBox x:Name="RatingBox"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Количество (Quantity):"/>
                    <TextBox x:Name="QuantityBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="Счётчик (Count):"/>
                    <TextBox x:Name="CountBox"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="IsOverBox" Content="Товар недоступен для покупки (IsOver = true)" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="120" Height="35" Margin="5" Click="SaveButton_Click"/>
                <Button Content="Отмена" Width="120" Height="35" Margin="5" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
