<Page x:Class="WpfAppPR4.Pages.EditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppPR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditProductPage">

    <Grid>
        <ScrollViewer>
            <StackPanel Width="400">
            <TextBlock x:Name="TitleText" Text="Добавление товара" FontSize="25" Margin="15" HorizontalAlignment="Center"/>

            <TextBlock Text="Название:" FontSize="20" Margin="5"/>
            <TextBox x:Name="NameBox" Margin="5" Height="30" FontSize="20"/>

            <TextBlock Text="Описание:" FontSize="20" Margin="5"/>
            <TextBox x:Name="DescriptionBox" Margin="5" FontSize="20" TextWrapping="Wrap"/>

            <TextBlock Text="Категория:" FontSize="20" Margin="5"/>
            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="5" FontSize="20"/>

            <TextBlock Text="Ссылка на изображение:" FontSize="20" Margin="5"/>
            <TextBox x:Name="ImageBox" Margin="5" FontSize="20"/>

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Цена:" FontSize="15"/>
                    <TextBox x:Name="PriceBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Рейтинг:" FontSize="15"/>
                    <TextBox x:Name="RatingBox"/>
                </StackPanel>
            </Grid>

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Количество:" FontSize="15"/>
                    <TextBox x:Name="QuantityBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Счётчик:" FontSize="15"/>
                    <TextBox x:Name="CountBox"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="IsOverBox" Content="Товар недоступен для покупки" Margin="5" FontSize="15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="120" Height="30" FontSize="20" Margin="5" Click="SaveButton_Click"/>
                <Button Content="Отмена" Width="120" Height="30" Margin="5" FontSize="20" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
